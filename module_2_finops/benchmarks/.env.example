# ─────────────────────────────────────────────────────────────
# Module 2 FinOps Benchmarks — Environment Config
# Copy this file to .env and fill in your API keys
# ─────────────────────────────────────────────────────────────

# ── LiteLLM Gateway (must be running) ────────────────────────
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-litellm-master-2026

# ── Langfuse Observability ────────────────────────────────────
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=ls-sk-xxxxxxxx

# ─────────────────────────────────────────────────────────────
# CROSS-PROVIDER MODEL ROUTING
# Each task complexity routes to a different model/provider.
# LiteLLM handles all providers transparently.
# ─────────────────────────────────────────────────────────────

# PHASE 1 — Stabilisation (cheap models)
# MODEL_SIMPLE=mistral/mistral-small-latest
# MODEL_MODERATE=mistral/mistral-large-latest
# MODEL_COMPLEX=mistral/mistral-large-latest
# MODEL_DEFAULT=mistral/mistral-small-latest

# PHASE 1 — Cross-provider (mix cheap models)
MODEL_SIMPLE=mistral/mistral-small-latest
MODEL_MODERATE=deepseek/deepseek-chat
MODEL_COMPLEX=mistral/mistral-large-latest
MODEL_DEFAULT=mistral/mistral-small-latest

# PHASE 2 — Demo / Pre-prod (premium models)
# MODEL_SIMPLE=claude-haiku
# MODEL_MODERATE=claude-sonnet
# MODEL_COMPLEX=claude-opus
# MODEL_DEFAULT=claude-haiku

# PHASE 2 — Cross-provider premium
# MODEL_SIMPLE=mistral/mistral-small-latest
# MODEL_MODERATE=deepseek/deepseek-chat
# MODEL_COMPLEX=claude-sonnet
# MODEL_DEFAULT=mistral/mistral-small-latest

# ── Provider API Keys (only the ones you use) ─────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
MISTRAL_API_KEY=xxxxxxxx
DEEPSEEK_API_KEY=xxxxxxxx
GEMINI_API_KEY=xxxxxxxx
OPENAI_API_KEY=xxxxxxxx

# ── Benchmark settings ────────────────────────────────────────
MONTHLY_CALLS=500000          # for prompt benchmark projection
DAILY_CALLS=100000            # for cache/routing projections
DAILY_CONVERSATIONS=10000     # for history benchmark
